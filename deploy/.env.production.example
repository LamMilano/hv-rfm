# ── Mẫu .env cho PRODUCTION ─────────────────────────────────────────────────
# Copy thành backend/.env rồi điền bí mật thật. KHÔNG commit file .env đã điền.
#   cp ../deploy/.env.production.example .env
# Sinh chuỗi ngẫu nhiên: openssl rand -hex 32 (JWT) / openssl rand -hex 24 (API key)

# ── Bắt buộc ──────────────────────────────────────────────────────────────
# Postgres 16 trên chính server (DB mri_waitlist đã dựng sẵn).
DATABASE_URL=postgresql://mri:ĐỔI_MẬT_KHẨU@localhost:5432/mri_waitlist
JWT_SECRET=ĐỔI_openssl_rand_hex_32

# ── Xác thực apihrm (hệ tài khoản bệnh viện) ──────────────────────────────────────────
HIS_AUTH_URL=https://hrm.example.vn/api/v2/Auth/login
HIS_AUTH_ENABLED=true
# Tài khoản dịch vụ HRM để lấy danh sách khoa/nhân viên (tạo user hàng loạt).
# Để trống → admin nhập mã NV + mật khẩu HRM của mình trên trang quản trị.
HRM_API_MANV=
HRM_API_MAT_KHAU=
# Gốc API nhân sự — mặc định lấy origin của HIS_AUTH_URL.
# HRM_API_BASE=https://hrm.example.vn

# ── Khóa riêng cho HIS push chỉ định MRI (giữ dự phòng, bàn giao IT) ─────────
HIS_PUSH_API_KEY=ĐỔI_openssl_rand_hex_24

# ── HIS KÉO (pull) chỉ định MRI — app tự gọi API HIS theo chu kỳ ────────────
HIS_PULL_ENABLED=true
# Endpoint; để trống → suy từ HIS_AUTH_URL + /api/CanLamSang/mri.
# HIS_PULL_URL=https://hrm.example.vn/api/CanLamSang/mri
# Chu kỳ (giây) chỉnh ở trang Cấu hình → Tích hợp HIS (app_settings his_pull_chu_ky_giay).
# Dùng chung HRM_API_MANV/HRM_API_MAT_KHAU nếu endpoint yêu cầu token.

# ── Thông báo SMS/Zalo (cắm sau) ────────────────────────────────────────────
ZALO_HUB_KEY=
SMS_PROVIDER_KEY=

# ── Khác ─────────────────────────────────────────────────────────────────────
PORT=3003
NODE_ENV=production
FRONTEND_URL=https://mri.example.vn
