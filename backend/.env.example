# ── Bắt buộc ──────────────────────────────────────────────────────────────
# Mặc định khớp docker-compose (port 5433). Postgres sẵn có → sửa cho khớp.
DATABASE_URL=postgresql://mri:mri_local_dev@localhost:5433/mri_waitlist
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# ── Xác thực apihrm (hệ tài khoản bệnh viện) ────────────────────────────────
HIS_AUTH_URL=https://hrm.example.vn/api/v2/Auth/login
HIS_AUTH_ENABLED=true
# Tài khoản dịch vụ HRM để lấy danh sách khoa/nhân viên (tạo user hàng loạt).
# Để trống → admin nhập mã NV + mật khẩu HRM của mình trên trang quản trị.
HRM_API_MANV=
HRM_API_MAT_KHAU=
# Gốc API nhân sự — mặc định lấy origin của HIS_AUTH_URL.
# HRM_API_BASE=https://hrm.example.vn

# ── Khóa riêng cho HIS push chỉ định MRI (giữ làm dự phòng, tách khỏi JWT) ──
HIS_PUSH_API_KEY=doi-thanh-khoa-rieng-cho-HIS

# ── HIS KÉO (pull) chỉ định MRI — app tự gọi API HIS theo chu kỳ ────────────
# Bật/tắt poller tự gọi (nút "Làm mới" thủ công vẫn chạy khi tắt).
HIS_PULL_ENABLED=true
# Endpoint lấy chỉ định MRI. Để trống → tự suy ra origin HIS_AUTH_URL + /api/CanLamSang/mri.
# HIS_PULL_URL=https://hrm.example.vn/api/CanLamSang/mri
# Chu kỳ tự gọi (giây) cấu hình ở app_settings 'his_pull_chu_ky_giay' (admin chỉnh được).
# Tài khoản gọi API dùng chung HRM_API_MANV/HRM_API_MAT_KHAU ở trên (nếu endpoint cần token).

# ── Thông báo SMS/Zalo (cắm sau — để trống thì module tắt) ──────────────────
ZALO_HUB_KEY=
SMS_PROVIDER_KEY=

# ── Khác ────────────────────────────────────────────────────────────────────
PORT=3003
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
